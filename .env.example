# Keycloak Configuration
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Database
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# Backend Config
PORT=3000
SESSION_SECRET=  # >= 32 chars, generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
KEYCLOAK_REALM=TestRealm
KEYCLOAK_CLIENT_ID=bff-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://keycloak:8080/realms/TestRealm
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/TestRealm
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379
# REDIS_TLS=false

# Frontend
FRONTEND_URL=http://localhost:8082
CORS_ORIGINS=http://localhost:8082

# Proxy
PROTECTED_SERVICE_URL=http://protected-service:8080

# Production hostname (used by docker-compose.prod.yml)
KC_HOSTNAME=keycloak
