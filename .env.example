# Keycloak Admin
KEYCLOAK_ADMIN=<set_in_production>
KC_BOOTSTRAP_ADMIN_USERNAME=<set_in_production>
KC_BOOTSTRAP_ADMIN_PASSWORD=<set_in_production>

# PostgreSQL
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=<set_in_production>
POSTGRES_DB=keycloak

# BFF Session
SESSION_SECRET=<generate_64_char_random>
SESSION_TTL=86400

# Keycloak OIDC
KEYCLOAK_REALM=TestRealm
KEYCLOAK_ISSUER=http://keycloak:8080/realms/TestRealm
KEYCLOAK_CLIENT_ID=protected-client
KEYCLOAK_CLIENT_SECRET=<set_in_production>
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback

# Frontend
FRONTEND_URL=http://localhost:8082
CORS_ORIGINS=http://localhost:8082

# Protected Service
PROTECTED_SERVICE_URL=http://protected-service:8080

# App
PORT=3000
NODE_ENV=development
