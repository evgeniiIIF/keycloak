# === Infrastructure (Docker) ===
# Copy this file to .env and fill in the values

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=TestRealm
KC_HOSTNAME=localhost

# Keycloak Client
KEYCLOAK_CLIENT_ID=bff-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://keycloak:8080/realms/TestRealm
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/TestRealm

# Database
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# BFF
PORT=3000
NODE_ENV=development
SESSION_SECRET=  # >= 32 chars
SESSION_TTL=86400
SESSION_COOKIE_NAME=connect.sid
SESSION_PREFIX=sess:
OAUTH_STATE_TTL=600
FRONTEND_URL=http://localhost:8082
PROTECTED_SERVICE_URL=http://protected-service:8080
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback
KEYCLOAK_LOGOUT_REDIRECT_URI=http://localhost:8082/

# Frontend
VITE_API_URL=http://localhost:3000
