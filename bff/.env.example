# === Local Run (BFF) ===
# Copy this file to .env and fill in the values

# Keycloak
KEYCLOAK_CLIENT_ID=bff-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/TestRealm
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/TestRealm

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# BFF
PORT=3000
NODE_ENV=development
SESSION_SECRET=  # >= 32 chars
SESSION_TTL=86400
SESSION_COOKIE_NAME=connect.sid
SESSION_PREFIX=sess:
OAUTH_STATE_TTL=600
FRONTEND_URL=http://localhost:8082
PROTECTED_SERVICE_URL=http://localhost:8083

# Frontend
VITE_API_URL=http://localhost:3000
